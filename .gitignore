# Ignore everything
*

# Allow all directories
!*/

# Re-ignore hidden directories (.claude, .vscode, .review, etc.)
.*

# Allow .gitignore itself
!/.gitignore

# Tracked file types
!*.m
!*.tex
!*.pdf
!*.xlsx
!*.bib
!*.sty

